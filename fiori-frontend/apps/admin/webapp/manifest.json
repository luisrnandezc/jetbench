{
  "_version": "1.65.0",
  "sap.app": {
    "id": "jetbench.admin",
    "type": "application",
    "title": "JetBench Admin",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.143.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "rootView": {
      "viewName": "jetbench.admin.view.App",
      "type": "XML",
      "async": false,
      "id": "rootView"
    },
    "models": {
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "jetbench.admin.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "main",
          "target": "main"
        },
        {
          "pattern": "organizations/{ID}",
          "name": "organizationDetail",
          "target": "organizationDetail"
        },
        {
          "pattern": "users/{ID}",
          "name": "userDetail",
          "target": "userDetail"
        }
      ],
      "targets": {
        "main": {
          "viewType": "XML",
          "viewId": "main",
          "viewName": "Main"
        },
        "organizationDetail": {
          "viewType": "XML",
          "viewId": "organizationDetail",
          "viewName": "OrganizationDetail"
        },
        "userDetail": {
          "viewType": "XML",
          "viewId": "userDetail",
          "viewName": "UserDetail"
        }
      }
    }
  }
}
