<mvc:View
    controllerName="jetbench.admin.controller.EditAircraft"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page 
        title="Edit Aircraft"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">

        <content>
            <f:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                columnsXL="1"
                columnsL="1"
                columnsM="1">

                <Label text="Tail number" required="true"/>
                <Input value="{tailNumber}" editable="true"/>

                <Label text="Serial number" required="true"/>
                <Input value="{serialNumber}" required="true"/>

                <Label text="Model" required="true"/>
                <Input value="{aircraftModel/name}" required="true" />

                <Label text="Total flight hours"/>
                <Input value="{totalFlightHours}" />

                <Label text="Total cycles"/>
                <Input value="{totalCycles}" />

                <Label text="Status"/>
                <Input value="{status}"/>

            </f:SimpleForm>
            <Toolbar class="sapUiMediumMarginTop">

                <Button 
                    text="Delete"
                    type="Reject"
                    icon="sap-icon://delete"
                    press=".onDeleteAircraft"/>

                <ToolbarSpacer/>
                <Button text="Save" type="Emphasized" press=".onSave"/>
                <Button text="Cancel" press=".onCancel"/>
            </Toolbar>
        </content>

    </Page>
</mvc:View>
