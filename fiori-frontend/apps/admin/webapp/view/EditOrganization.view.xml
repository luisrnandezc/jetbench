<mvc:View
    controllerName="jetbench.admin.controller.EditOrganization"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page 
        title="Edit Organization"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">

        <content>
            <f:SimpleForm 
                editable="true" 
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                columnsXL="1"
                columnsL="1"
                columnsM="1">

                <Label text="Name" required="true"/>
                <Input value="{name}" editable="true"/>

                <Label text="Code" required="true"/>
                <Input value="{code}" required="true"/>

                <Label text="Legal Name"/>
                <Input value="{legalName}"/>

                <Label text="Type" required="true"/>
                <Select
                    selectedKey="{type}"
                    width="100%"
                    items="{/OrganizationTypes}">
                    <core:Item key="{code}" text="{name}" />
                </Select>

                <Label text="Country"/>
                <Input value="{country}" maxLength="2" placeholder="e.g. US, CA"/>

                <Label text="City"/>
                <Input value="{city}"/>

                <Label text="Timezone"/>
                <Input value="{timezone}"/>

                <Label text="Primary Contact Name" required="true"/>
                <Input value="{primaryContactName}" required="true"/>

                <Label text="Primary Contact Email" required="true"/>
                <Input value="{primaryContactEmail}" type="Email" required="true"/>

                <Label text="Primary Contact Phone"/>
                <Input value="{primaryContactPhone}" type="Tel"/>

            </f:SimpleForm>
            <Toolbar class="sapUiMediumMarginTop">

                <Button 
                    text="Delete"
                    type="Reject"
                    icon="sap-icon://delete"
                    press=".onDeleteOrganization"/>

                <ToolbarSpacer/>
                <Button text="Save" type="Emphasized" press=".onSave"/>
                <Button text="Cancel" press=".onCancel"/>
            </Toolbar>

            <Title text="Assigned Aircraft" level="H2" class="sapUiMediumMarginTop"/>
            <Table
                id="organizationAircraftTable"
                growing="true"
                growingThreshold="10"
                items="{
                    path: 'aircraft',
                    parameters: {
                    $expand: 'aircraftModel'
                    }
                }">

                <columns>
                    <Column width="12rem" hAlign="Center">
                        <Text text="Tail number" />
                    </Column>
                    <Column width="12rem" hAlign="Center">
                        <Text text="Serial number" />
                    </Column>
                    <Column width="12rem" hAlign="Center">
                        <Text text="Model" />
                    </Column>
                    <Column width="12rem" hAlign="Center">
                        <Text text="Flight hours" />
                    </Column>
                    <Column width="12rem" hAlign="Center">
                        <Text text="Cycles" />
                    </Column>
                    <Column width="12rem" hAlign="Center">
                        <Text text="Status" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                    type="Navigation"
                    press=".onOrganizationPress">

                    <cells>
                        <Text text="{tailNumber}" />
                        <Text text="{serialNumber}" />
                        <Text text="{aircraftModel/name}" />
                        <Text text="{totalFlightHours}" />
                        <Text text="{totalCycles}" />
                        <Text text="{status}" />
                    </cells>

                    </ColumnListItem>
                </items>
            </Table>

            <Title text="Assigned Engines" level="H2" class="sapUiMediumMarginTop"/>
            <Table
                id="organizationEnginesTable"
                growing="true"
                growingThreshold="10"
                items="{
                    path: 'engines',
                    parameters: {
                    $expand: 'engineModel,aircraft'
                    }
                }">

                <columns>
                    <Column hAlign="Center">
                        <Text text="Serial number" />
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Model" />
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Aircraft" />
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Position" />
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Hours" />
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Cycles" />
                    </Column>
                    <Column hAlign="Center">
                        <Text text="Status" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                    type="Navigation"
                    press=".onOrganizationPress">

                    <cells>
                        <Text text="{engineSerialNumber}" />
                        <Text text="{engineModel/name}" />
                        <Text text="{aircraft/tailNumber}" />
                        <Text text="{positionCode}" />
                        <Text text="{totalFlightHours}" />
                        <Text text="{totalCycles}" />
                        <Text text="{status}" />
                    </cells>

                    </ColumnListItem>
                </items>
            </Table>
        </content>

    </Page>
</mvc:View>
