<mvc:View
  controllerName="jetbench.admin.controller.Main"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">

  <Page title="JetBench Admin">
    <content>
      <VBox class="sapUiMediumMargin" width="auto">

        <!-- Organizations section -->
        <Toolbar>
          <Title text="Organizations" level="H2" />
          <ToolbarSpacer />
          <Button 
            text="New Organization" 
            icon="sap-icon://add" 
            type="Emphasized"
            press=".onOpenCreateOrganizationDialog" />
        </Toolbar>

        <Table
          id="organizationsTable"
          growing="true"
          growingThreshold="20"
          items="{/Organizations}">

          <columns>
            <Column width="12rem" hAlign="Center">
              <Text text="Name" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Code" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Country" />
            </Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onOrganizationPress">

              <cells>
                <Text text="{name}" />
                <Text text="{code}" />
                <Text text="{country}" />
              </cells>

            </ColumnListItem>
          </items>
        </Table>

        <!-- Users section -->
        <Toolbar class="sapUiMediumMarginTop">
          <Title text="Users" level="H2" />
          <ToolbarSpacer />
          <Button 
            text="New User" 
            icon="sap-icon://add" 
            type="Emphasized"
            press=".onOpenCreateUserDialog" />
        </Toolbar>

        <Table
          id="usersTable"
          growing="true"
          growingThreshold="20"
          items="{
            path: '/Users',
            parameters: {
              $expand: 'organization'
            }
          }">

          <columns>
            <Column width="12rem" hAlign="Center">
              <Text text="Name" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Email" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Role" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Organization" />
            </Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onUserPress">

              <cells>
                <Text text="{firstName} {lastName}" />
                <Text text="{email}" />
                <Text text="{role}" />
                <Text text="{organization/name}" />
              </cells>

            </ColumnListItem>
          </items>
        </Table>

      </VBox>

      <!-- Create Organization Dialog -->
      <Dialog 
        id="createOrganizationDialog" 
        title="Register Organization" 
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content sapUiResponsivePadding--footer">
        
        <content>
          <VBox class="sapUiSmallMargin" width="20rem">
            <Label text="Name" labelFor="orgNameInput" />
            <Input id="orgNameInput" required="true" />

            <Label text="Code" labelFor="orgCodeInput" />
            <Input id="orgCodeInput" required="true" />

            <Label text="Country" labelFor="orgCountryInput" />
            <Input id="orgCountryInput" required="true" />
          </VBox>
        </content>

        <beginButton>
          <Button text="Cancel" press=".onCloseCreateOrganizationDialog" />
        </beginButton>

        <endButton>
          <Button 
            text="Create" 
            type="Emphasized" 
            press=".onCreateOrganization" />
        </endButton>
      </Dialog>

      <!-- Create User Dialog -->
      <Dialog 
        id="createUserDialog" 
        title="Register User" 
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content sapUiResponsivePadding--footer">
        
        <content>
          <VBox class="sapUiSmallMargin" width="20rem">
            <Label text="First Name" labelFor="userFirstNameInput" />
            <Input id="userFirstNameInput" required="true" />

            <Label text="Last Name" labelFor="userLastNameInput" />
            <Input id="userLastNameInput" required="true" />

            <Label text="Email" labelFor="userEmailInput" />
            <Input id="userEmailInput" type="Email" required="true" />

            <Label text="Role" labelFor="userRoleSelect" />
            <Select id="userRoleSelect" width="100%" required="true">
                <core:Item key="Staff" text="Staff" />
                <core:Item key="Engineer" text="Engineer" />
                <core:Item key="Technician" text="Technician" />
                <core:Item key="Inspector" text="Inspector" />
                <core:Item key="Pilot" text="Pilot" />
                <core:Item key="Operator" text="Operator" />
                <core:Item key="Other" text="Other" />
            </Select>

            <Label text="Organization" labelFor="userOrganizationSelect" />
            <Select 
              id="userOrganizationSelect" 
              width="100%"
              items="{/Organizations}"
              required="true">
              <core:Item 
                key="{ID}" 
                text="{name}" />
            </Select>
          </VBox>
        </content>

        <beginButton>
          <Button text="Cancel" press=".onCloseCreateUserDialog" />
        </beginButton>

        <endButton>
          <Button 
            text="Create" 
            type="Emphasized" 
            press=".onCreateUser" />
        </endButton>
      </Dialog>

    </content>
  </Page>
</mvc:View>
