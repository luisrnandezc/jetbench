<mvc:View
  controllerName="jetbench.admin.controller.Main"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">

  <Page title="JetBench Admin">
    <content>
      <VBox class="sapUiMediumMargin" width="auto">

        <!-- Organizations section -->
        <Toolbar>
          <Title text="Organizations" level="H2" />
          <ToolbarSpacer />
          <Button 
            text="New Organization" 
            icon="sap-icon://add" 
            type="Emphasized"
            press=".onCreateOrganization" />
        </Toolbar>

        <Table
          id="organizationsTable"
          growing="true"
          growingThreshold="20"
          items="{/Organizations}">

          <columns>
            <Column width="12rem" hAlign="Center">
              <Text text="Name" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Code" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Country" />
            </Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onOrganizationPress">

              <cells>
                <Text text="{name}" />
                <Text text="{code}" />
                <Text text="{country}" />
              </cells>

            </ColumnListItem>
          </items>
        </Table>

        <!-- Users section -->
        <Toolbar class="sapUiMediumMarginTop">
          <Title text="Users" level="H2" />
          <ToolbarSpacer />
          <Button 
            text="New User" 
            icon="sap-icon://add" 
            type="Emphasized"
            press=".onCreateUser" />
        </Toolbar>

        <Table
          id="usersTable"
          growing="true"
          growingThreshold="20"
          items="{
            path: '/Users',
            parameters: {
              $expand: 'organization'
            }
          }">

          <columns>
            <Column width="12rem" hAlign="Center">
              <Text text="Name" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Email" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Role" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center">
              <Text text="Organization" />
            </Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onUserPress">

              <cells>
                <Text text="{firstName} {lastName}" />
                <Text text="{email}" />
                <Text text="{role}" />
                <Text text="{organization/name}" />
              </cells>

            </ColumnListItem>
          </items>
        </Table>

      </VBox>

    </content>
  </Page>
</mvc:View>
