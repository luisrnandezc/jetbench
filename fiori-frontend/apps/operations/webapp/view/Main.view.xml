<mvc:View
  controllerName="jetbench.operations.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">

  <Page title="JetBench Operations">
    <content>
      <VBox class="sapUiMediumMargin" width="auto">

        <Toolbar>
          <Title text="Flight Records" level="H2" />
          <ToolbarSpacer />
          <Button
            text="New Flight Record"
            icon="sap-icon://add"
            type="Emphasized"
            press=".onCreateFlightRecord" />
        </Toolbar>

        <Table
          id="flightRecordsTable"
          growing="true"
          growingThreshold="20"
          items="{
            path: '/FlightRecords',
            parameters: {
              $expand: 'aircraft,recordedBy'
            }
          }">

          <columns>
            <Column>
              <Text text="Date" />
            </Column>
            <Column>
              <Text text="Aircraft" />
            </Column>
            <Column>
              <Text text="Hours" />
            </Column>
            <Column>
              <Text text="Cycles" />
            </Column>
            <Column>
              <Text text="Recorded By" />
            </Column>
            <Column>
              <Text text="Notes" />
            </Column>
          </columns>

          <items>
            <ColumnListItem>
              <cells>
                <Text text="{flightDate}" />
                <Text text="{aircraft/tailNumber}" />
                <Text text="{flightHours}" />
                <Text text="{cycles}" />
                <Text text="{recordedBy/firstName} {recordedBy/lastName}" />
                <Text text="{notes}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <Title text="Aircraft" level="H2" class="sapUiMediumMarginTop" />

        <Table
          id="aircraftTable"
          growing="true"
          growingThreshold="20"
          items="{
            path: '/Aircraft',
            parameters: {
              $expand: 'aircraftModel'
            }
          }">

          <columns>
            <Column>
              <Text text="Tail Number" />
            </Column>
            <Column>
              <Text text="Model" />
            </Column>
            <Column>
              <Text text="Flight Hours" />
            </Column>
            <Column>
              <Text text="Cycles" />
            </Column>
            <Column>
              <Text text="Status" />
            </Column>
          </columns>

          <items>
            <ColumnListItem>
              <cells>
                <Text text="{tailNumber}" />
                <Text text="{aircraftModel/name}" />
                <Text text="{totalFlightHours}" />
                <Text text="{totalCycles}" />
                <Text text="{status}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

        <Title text="Engines" level="H2" class="sapUiMediumMarginTop" />

        <Table
          id="enginesTable"
          growing="true"
          growingThreshold="20"
          items="{
            path: '/Engines',
            parameters: {
              $expand: 'engineModel,aircraft'
            }
          }">

          <columns>
            <Column>
              <Text text="Serial Number" />
            </Column>
            <Column>
              <Text text="Model" />
            </Column>
            <Column>
              <Text text="Aircraft" />
            </Column>
            <Column>
              <Text text="Flight Hours" />
            </Column>
            <Column>
              <Text text="Cycles" />
            </Column>
            <Column>
              <Text text="Status" />
            </Column>
          </columns>

          <items>
            <ColumnListItem>
              <cells>
                <Text text="{engineSerialNumber}" />
                <Text text="{engineModel/name}" />
                <Text text="{aircraft/tailNumber}" />
                <Text text="{totalFlightHours}" />
                <Text text="{totalCycles}" />
                <Text text="{status}" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </VBox>
    </content>
  </Page>
</mvc:View>