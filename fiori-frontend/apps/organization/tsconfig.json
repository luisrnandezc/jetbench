{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "rootDir": "webapp",
    "outDir": "dist",
    "baseUrl": "./",
    "paths": {
      "jetbench/organization/*": ["webapp/*"]
    },
    "types": ["@openui5/types"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["webapp/**/*"]
}
