{
  "_version": "1.61.0",
  "sap.app": {
    "id": "jetbench.organization",
    "type": "application",
    "title": "JetBench Organization",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/organization/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.143.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "rootView": {
      "viewName": "jetbench.organization.view.App",
      "type": "XML",
      "async": false,
      "id": "rootView"
    },
    "models": {
      "": {
        "type": "sap.ui.model.odata.v4.ODataModel",
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "jetbench.organization.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "main",
          "target": "main"
        },
        {
          "pattern": "aircraft/create",
          "name": "createAircraft",
          "target": "createAircraft"
        },
        {
          "pattern": "aircraft/{ID}",
          "name": "editAircraft",
          "target": "editAircraft"
        },
        {
          "pattern": "engines/create",
          "name": "createEngine",
          "target": "createEngine"
        },
        {
          "pattern": "engines/{ID}",
          "name": "editEngine",
          "target": "editEngine"
        }
      ],
      "targets": {
        "main": {
          "viewType": "XML",
          "viewId": "main",
          "viewName": "Main"
        },
        "createAircraft": {
          "viewType": "XML",
          "viewId": "createAircraft",
          "viewName": "CreateAircraft"
        },
        "editAircraft": {
          "viewType": "XML",
          "viewId": "editAircraft",
          "viewName": "EditAircraft"
        },
        "createEngine": {
          "viewType": "XML",
          "viewId": "createEngine",
          "viewName": "CreateEngine"
        },
        "editEngine": {
          "viewType": "XML",
          "viewId": "editEngine",
          "viewName": "EditEngine"
        }
      }
    }
  }
}
