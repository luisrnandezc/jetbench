<mvc:View
  controllerName="jetbench.organization.controller.CreateEngine"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">

  <Page
    title="Create Engine"
    showNavButton="true"
    navButtonPress=".onNavBack"
    class="sapUiResponsiveContentPadding">

    <content>
      <f:SimpleForm
        editable="true"
        layout="ResponsiveGridLayout">

        <Label text="Serial number" required="true" />
        <Input value="{form>/engineSerialNumber}" required="true" />

        <Label text="Engine model" required="true" />
        <Select
          selectedKey="{form>/engineModel_ID}"
          items="{/EngineModels}">
          <core:Item key="{ID}" text="{name}" />
        </Select>

        <Label text="Assigned aircraft" />
        <Select
          selectedKey="{form>/aircraft_ID}"
          items="{/Aircraft}">
          <core:Item key="{ID}" text="{tailNumber}" />
        </Select>

        <Label text="Position code" />
        <Input value="{form>/positionCode}" placeholder="e.g. L, R, 1, 2" />

        <Label text="Status" />
        <Select selectedKey="{form>/status}">
          <core:Item key="INSTALLED" text="Installed" />
          <core:Item key="UNINSTALLED" text="Uninstalled" />
          <core:Item key="MAINTENANCE" text="Maintenance" />
          <core:Item key="RETIRED" text="Retired" />
        </Select>

      </f:SimpleForm>
    </content>

    <footer>
      <Toolbar>
        <ToolbarSpacer />
        <Button text="Create" type="Emphasized" press=".onCreate" />
        <Button text="Cancel" press=".onCancel" />
      </Toolbar>
    </footer>
  </Page>
</mvc:View>